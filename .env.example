# Copy to .env in this directory and fill your W&B key, Hugging Face username and write token.
# Keep .env private. run_settings.toml contains the editable run defaults.
# Values are literal; shell commands and variable expansion are not supported.
WANDB_API_KEY=
# Required when [huggingface].enabled = true: your account or organization.
HF_USERNAME=
# A Hugging Face token with write access to HF_USERNAME; never put it in TOML.
HF_TOKEN=
# Optional override of [huggingface].enabled; prefer editing run_settings.toml.
# HF_UPLOAD_ENABLED=true
# Optional account/team override (otherwise [wandb].entity in run_settings.toml).
# WANDB_ENTITY=my-team

# Existing WANDB_* and VALIDATION_* settings remain supported here, but they
# override run_settings.toml. Prefer editing run_settings.toml for run settings.
# Exported environment values override .env; explicit CLI options override both.
